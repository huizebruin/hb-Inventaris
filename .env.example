# Kopieer dit bestand naar ".env" en vul je eigen waarden in.
# De app moet ook zonder deze waarden kunnen opstarten (AI/Telegram features
# zijn dan gewoon uitgeschakeld).

# --- Gemini AI (optioneel, voor spec-lookup / duplicate detection / etc.) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Telegram notificaties (optioneel, voor build-meldingen) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Beheer, back-ups en opslag (alles optioneel, dit zijn de standaardwaarden) ---
# HB_BACKUP_TIME=00:00            # dagelijks tijdstip van de automatische backup
# HB_BACKUP_RETENTION_DAYS=14     # backups ouder dan dit worden opgeruimd
# HB_BACKUP_KEEP_MIN=3            # zoveel nieuwste GELDIGE backups blijven altijd staan
# HB_BACKUP_STALE_HOURS=36        # backup ouder dan dit = "niet actueel" (waarschuwing)
# HB_DISK_WARN_PCT=85             # waarschuwing bij zoveel % schijf gebruikt
# HB_DISK_CRIT_PCT=95
# HB_DISK_WARN_FREE_MB=500        # of bij minder dan zoveel MB vrij
# HB_MAX_UPLOAD_MB=25             # maximale grootte per upload
# HB_MEDIA_MAX_MB=0               # maximale totale grootte mediamap (0 = onbeperkt)
# HB_LOG_MAX_MB=2                 # logrotatie: grootte per logbestand
# HB_LOG_BACKUPS=5                # aantal oude logbestanden
# HB_ADMIN_TOKEN=                 # als ingevuld: beheer-acties (restore, repair, import) vragen dit token

# --- Beveiliging (zie docs/DEPLOYMENT.md) ---
# HB_AUTH_USER=                   # login voor de hele app (HTTP Basic); alleen samen met HB_AUTH_PASSWORD, bij voorkeur over HTTPS
# HB_AUTH_PASSWORD=
# HB_ORPHAN_GRACE_MIN=60          # recent geüploade, nog niet gekoppelde bestanden worden zo lang niet als "ongebruikt" gezien

# --- E-mailmeldingen (optioneel, server-side) ---
# SMTP_HOST=smtp.example.nl
# SMTP_PORT=587                   # 587 = STARTTLS, 465 = SSL
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=                      # afzender; standaard gelijk aan SMTP_USER
# HB_EMAIL=                       # ontvanger(s), meerdere gescheiden door komma
# HB_MAIL_DIGEST_TIME=08:00       # dagelijks overzicht (lage voorraad, verloopt, systeemmeldingen); leeg = uit. Alleen een mail als er iets te melden is
# HB_MAIL_EXPIRY_DAYS=14          # verloopdatum melden vanaf zoveel dagen vooraf
# HB_MAIL_ALERTS=1                # directe mail als de automatische backup na 3 pogingen mislukt (0 = uit)

# --- Prijzen ---
# HB_PRICE_ALERT_PCT=10           # melding bij een prijsstijging van minstens zoveel procent (0 = uit)
# HB_PRICE_ALERT_DAYS=14          # zo lang blijft een prijsstijging in het belletje staan

# --- Taal ---
# HB_LANG=nl                      # taal van e-mails (nl of en). De taal van de app kies je zelf in het menu (Language / Taal)

# --- Updates ---
# HB_UPDATE_CHECK=1               # elke 12 uur bij GitHub kijken of er een nieuwe versie is (0 = uit). Er wordt alleen de publieke release-info opgevraagd
# HB_UPDATE_INSTALL=1             # bijwerken vanuit de app toestaan (niet bij Docker; 0 = alleen melden)
# HB_UPDATE_REPO=huizebruin/hb-Inventaris   # alleen aanpassen als je een eigen fork volgt
