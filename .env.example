# Kopieer dit bestand naar ".env" en vul je eigen waarden in.
# De app moet ook zonder deze waarden kunnen opstarten (AI/Telegram features
# zijn dan gewoon uitgeschakeld).

# --- Gemini AI (optioneel, voor spec-lookup / duplicate detection / etc.) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Telegram notificaties (optioneel, voor build-meldingen) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
